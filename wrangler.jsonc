{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "journeyhub",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "not_found_handling": "single-page-application"
  }
}
